<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <activity
      android:name=".WearLiveVoicePocketStartActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:launchMode="singleTop"
      android:noHistory="true"
      android:showWhenLocked="true"
      android:taskAffinity=""
      android:theme="@style/PaseoWearPocketStartTheme"
      android:turnScreenOn="true">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="paseo-wear-live-voice" android:host="start" />
      </intent-filter>
    </activity>

    <!-- Play Services binds this even when the app process is dead, which is how a
         command sent from the watch reaches us at all. It must stay exported. -->
    <service
      android:name=".PaseoWearListenerService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data android:scheme="wear" android:host="*" android:pathPrefix="/paseo" />
      </intent-filter>
    </service>
  </application>
</manifest>
